# Credenciales exclusivas para esta prueba local. No usarlas en produccion.
POSTGRES_DB=unidad_educativa
POSTGRES_USER=unidad_admin
POSTGRES_PASSWORD=solo_pruebas_cambiar
POSTGRES_PORT=5433

# Conserva los backups de los ultimos 7 dias.
BACKUP_RETENTION_DAYS=7

# 86400 segundos = 24 horas. Para una prueba rapida se puede usar 60.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_ON_START=true
 